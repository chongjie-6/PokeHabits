# OpenHabits — environment
#
# Everything is optional. With nothing set the app is local-only: IndexedDB is
# the source of truth and /api/sync and /api/auth answer 503. See
# docs/DEPLOYMENT.md for the full story.

# --- Site ---------------------------------------------------------------------

# Public origin for link-preview image URLs. Falls back to BETTER_AUTH_URL, then
# Vercel's production domain, then http://localhost:3000.
SITE_URL=

# --- Database: sync and accounts ----------------------------------------------

# Postgres (Neon assumed); add ?sslmode=require when hosted. Turns on sync and
# accounts. Must NOT be a superuser — BYPASSRLS silently ignores row-level
# security (DESIGN.md §13.15). CI also needs it as a repository secret.
DATABASE_URL=

# --- Auth (required in production once DATABASE_URL is set) -------------------

# Signs session cookies; changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# The app's public origin, e.g. https://openhabits.example. Never inferred in
# production: verification links are built from it (§13.12).
BETTER_AUTH_URL=

# --- Mail ---------------------------------------------------------------------

# Gmail SMTP (an app password). Unset: no email verification, no password reset.
SMTP_USER=
SMTP_PASSWORD=

# From header; defaults to "OpenHabits <SMTP_USER>". Gmail only honours a
# different address if it is a verified "Send mail as" alias.
#   MAIL_FROM=OpenHabits <noreply@openhabits.example>
MAIL_FROM=

# --- Reminders (DESIGN.md §8.5; needs DATABASE_URL) ---------------------------

# VAPID keypair: npx web-push generate-vapid-keys
# Rotating the private key invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# mailto: or https: contact for push services. Falls back to BETTER_AUTH_URL.
VAPID_SUBJECT=

# Bearer token for the hourly /api/cron/reminders sweep; unset refuses to run.
# The Cloudflare Worker (workers/reminders.ts) needs the same value as a secret.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Upstash: rate limiting and mail queue (DESIGN.md §13.16, §13.17) ---------

# Redis REST credentials — both or neither. Turns on rate limiting and stores
# queued mail envelopes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash moves outbound mail out of the request. Needs Redis above and both
# signing keys below, or mail is enqueued and never delivered. Ignored on
# localhost. Failed sends land in the DLQ, which nothing alerts on.
QSTASH_TOKEN=

# Region endpoint from the QStash console; empty only for eu-central-1.
QSTASH_URL=

# Verify deliveries to /api/email; unset, the route refuses every request.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
